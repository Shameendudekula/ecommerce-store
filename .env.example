# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Use the database name ecommerce-store after the host. If your password contains
# special characters such as @ : / ? #, URL-encode them (e.g. @ -> %40).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce-store?retryWrites=true&w=majority

# Secret used to sign login tokens (JWTs). At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login stays valid (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Port for local development (Render sets PORT automatically).
# 5050 rather than 5000 because macOS AirPlay Receiver already uses port 5000.
PORT=5050

# Optional: only needed if the frontend is hosted on a different domain (comma-separated)
# CLIENT_URL=http://localhost:3000
